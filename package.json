{
  "name": "teleprompter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"server,next\" -c \"green,blue\" \"npm run dev:server\" \"npm run dev:next\"",
    "dev:next": "next dev -p 3000",
    "dev:server": "tsx watch server/index.ts",
    "build": "next build",
    "start": "next start -p 3000",
    "start:server": "tsx server/index.ts",
    "start:all": "node server/start.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "@hono/node-ws": "^1.3.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "better-sqlite3": "^11.8.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "concurrently": "^10.0.5",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "next": "14.2.35",
    "partysocket": "^1.3.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/ws": "^8.18.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
